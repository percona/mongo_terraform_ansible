# mongod.conf - Shard Server

# for documentation of all options, see:
#   http://docs.mongodb.org/manual/reference/configuration-options/

# where to write logging data.
systemLog:
  destination: file
  logAppend: true
  logRotate: reopen
  path: {{ mongod_log_path }}/mongod.log

# Where and how to store data.
storage:
  dbPath: {{ mongod_path }}
  directoryPerDB: true
  wiredTiger:
    engineConfig:
      cacheSizeGB: {{ wired_tiger_cache_size_gb }}
# journal:
#   enabled: true

# how the process runs
processManagement:
  fork: true  # fork and run in background
  pidFilePath: /var/run/mongod.pid  # location of pidfile
  timeZoneInfo: /usr/share/zoneinfo

# network interfaces
net:
  port: {{ mongo_port }}
  bindIpAll: true
{% if use_tls %}
  tls:
    mode: requireTLS
    certificateKeyFile: {{ certificateKeyFile }}
    CAFile: {{ CAFile }}
    allowConnectionsWithoutCertificates: true
{% endif %}

security:
  authorization: enabled
{% if use_tls %}
  clusterAuthMode: x509
{% else %}
  keyFile: {{ keyFile_location }}
{% endif %}
{% if keyfile_encryption %}
  enableEncryption: true
  encryptionKeyFile: {{ encryption_keyfile }}
{% elif vault_encryption %}
  enableEncryption: true
  vault:
    serverName: {{ vault_server }}
    port: {{ vault_port }}
    tokenFile: {{ vault_tokenfile }}
    secret: {{ vault_secret }}
    serverCAFile: {{ vault_cafile }}
{% endif %}

operationProfiling:
   slowOpThresholdMs: 200
   mode: all
#   slowOpSampleRate: 0.1
   rateLimit: 100

replication:
  replSetName: {{ hostvars[inventory_hostname].group_names | reject('equalto', 'replsets') | list | first }}
  oplogSizeMB: {{ mongo_oplog_size_mb }}
{% if oidc_enabled %}

setParameter:
  authenticationMechanisms: MONGODB-OIDC,SCRAM-SHA-256
  oidcIdentityProviders:
    - issuer: "{{ oidc_issuer }}"
      audience: "{{ oidc_audience }}"
      clientId: "{{ oidc_client_id }}"
      authNamePrefix: "{{ oidc_auth_name_prefix }}"
      supportsHumanFlows: {{ oidc_supports_human_flows | lower }}
      principalName: "{{ oidc_principal_name }}"
      authorizationClaim: "{{ oidc_authorization_claim }}"
{% endif %}
