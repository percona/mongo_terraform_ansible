# mongot configuration - managed by Ansible
# Each mongot instance is co-located with a mongod data node and syncs from it
# over localhost using the dedicated {{ mongot_user }} user (searchCoordinator role).
syncSource:
  replicaSet:
    hostAndPort: "127.0.0.1:{{ mongo_port }}"
    username: {{ mongot_user }}
    passwordFile: "{{ mongot_password_file }}"
    authSource: admin
    readPreference: primaryPreferred
    tls: {{ 'true' if use_tls else 'false' }}
{% if use_tls %}
  caFile: {{ CAFile }}
{% endif %}
storage:
  dataPath: "{{ mongot_data_path }}"
server:
  grpc:
    address: "127.0.0.1:{{ mongot_grpc_port }}"
    tls:
{% if use_tls %}
      mode: "TLS"
      certificateKeyFile: {{ certificateKeyFile }}
{% else %}
      mode: "disabled"
{% endif %}
metrics:
  enabled: true
  address: "127.0.0.1:{{ mongot_metrics_port }}"
healthCheck:
  address: "127.0.0.1:{{ mongot_healthcheck_port }}"
logging:
  verbosity: INFO
