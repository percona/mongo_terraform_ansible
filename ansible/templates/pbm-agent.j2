{% if use_tls | bool %}
PBM_MONGODB_URI="mongodb://{{ pbmuser }}:{{ pbmpwd }}@{{ ansible_facts['fqdn'] }}:{{ mongo_port }}/?tls=true&tlsCertificateKeyFile={{ clientCertificateKeyFile }}&tlsCAFile={{ CAFile }}"
{% else %}
PBM_MONGODB_URI="mongodb://{{ pbmuser }}:{{ pbmpwd }}@localhost:{{ mongo_port }}"
{% endif %}
