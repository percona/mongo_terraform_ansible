FROM ${ ycsb_builder_image } AS ycsb-builder

ARG YCSB_SOURCE_REVISION=66302f301b13f60d4bcb2f29f478586bb1d6f2e0
ARG MAVEN_VERSION=3.6.3

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git tar \
    && curl -fsSL "https://archive.apache.org/dist/maven/maven-3/$${MAVEN_VERSION}/binaries/apache-maven-$${MAVEN_VERSION}-bin.tar.gz" -o /tmp/maven.tar.gz \
    && tar -xzf /tmp/maven.tar.gz -C /opt \
    && ln -s "/opt/apache-maven-$${MAVEN_VERSION}/bin/mvn" /usr/local/bin/mvn \
    && rm /tmp/maven.tar.gz \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/brianfrankcooper/YCSB.git /src/ycsb \
    && cd /src/ycsb \
    && git fetch --depth 1 origin "$${YCSB_SOURCE_REVISION}" \
    && git checkout --detach "$${YCSB_SOURCE_REVISION}" \
    && mvn -pl mongodb -am -DskipTests package \
    && mkdir /output \
    && tar -xzf mongodb/target/ycsb-mongodb-binding-*.tar.gz -C /output --strip-components=1

FROM ${ ycsb_os_image }

COPY --from=ycsb-builder /output /ycsb

RUN /bin/microdnf install -y python3 java-1.8.0-openjdk tar gzip \
    && ln -s /usr/bin/python3 /usr/bin/python \
    && chmod 755 /ycsb/bin/ycsb
